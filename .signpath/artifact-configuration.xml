<?xml version="1.0" encoding="utf-8"?>
<!-- Configuração de artefato do SignPath para o RecFlow (copie para o projeto no SignPath) -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="RecFlow-Setup.exe" product-name="RecFlow" product-version="${version}">
      <authenticode-sign/>
    </pe-file>
  </zip-file>
</artifact-configuration>
